# Transfer Desk HQ — secrets
# Copy to .env and fill in after creating your X app at https://developer.x.com

# X API (OAuth 1.0a — Read and Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# Optional: better paraphrasing (otherwise uses built-in rewrite)
OPENAI_API_KEY=

# Behaviour
# draft = write posts to drafts/ only | post = publish to X
POST_MODE=post
# How many recent posts to pull per breaker account
POSTS_PER_SOURCE=5
# Max posts per watch/post cycle
MAX_POSTS_PER_CYCLE=3

# Where seen.json / drafts / downloaded media live.
# Local dev: leave unset (defaults to repo root).
# Render: set to /var/data (see render.yaml disk mount).
TRANSFER_DESK_STORAGE=
