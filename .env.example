# Transfer Desk HQ — secrets
# Copy to .env and fill in after creating your X app at https://developer.x.com

# X API (OAuth 1.0a — Read and Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# Optional: better paraphrasing (otherwise uses built-in rewrite)
OPENAI_API_KEY=

# Behaviour
# draft = write posts to drafts/ only | post = publish to X
POST_MODE=post
# How many recent posts to pull per breaker account
POSTS_PER_SOURCE=5
# Max posts per watch/post cycle
MAX_POSTS_PER_CYCLE=3

# One-time pipeline smoke test: posts a short "posting works" tweet on the
# first successful cycle only, then never again. Set to false to disable.
SMOKETEST_ENABLED=true

# Desk features (consensus / sagas / scorecard / pulse)
# Max consensus+saga posts per cycle
MAX_EXTRAS_PER_CYCLE=2
# Hours two breakers must fall within to count as consensus; min distinct sources
CONSENSUS_WINDOW_HOURS=12
CONSENSUS_MIN_SOURCES=2
# Weekly scorecard day (0=Sun … 6=Sat, -1=off) and verification window
SCORECARD_DAY=0
SCORECARD_VERIFY_DAYS=21
# Daily rumour radar: posts once/day after this UTC hour (-1 = off);
# needs at least RADAR_MIN_ITEMS active rumours in the log
RADAR_HOUR=9
RADAR_MIN_ITEMS=3
RADAR_ACTIVE_DAYS=14
# Rumour Watch: reactive single-story odds update, posted whenever a
# tracked rumour's likelihood moves by RUMOURWATCH_DELTA points since the
# last update we posted about it (or on first sighting once it clears
# RUMOURWATCH_MIN_FIRST%). Cooldown avoids re-posting on tiny fluctuations;
# max per cycle keeps one big swing from flooding the timeline.
RUMOURWATCH_DELTA=12
RUMOURWATCH_MIN_FIRST=30
RUMOURWATCH_COOLDOWN_HOURS=3
RUMOURWATCH_MAX_PER_CYCLE=1
# Skip a story whose most recent contributing tip is older than this many
# hours — stops posting "first tracked odds" on a rumour that only crossed
# the score threshold now because of decay/corroboration math, when the
# underlying source tweet is actually days old.
RUMOURWATCH_MAX_AGE_HOURS=36
# Daily contract watch (renewals/extensions, excluded from the radar):
# posts once/day after this UTC hour (-1 = off), needs CONTRACTWATCH_MIN_ITEMS
# renewal stories logged in the last CONTRACTWATCH_DAYS
CONTRACTWATCH_HOUR=11
CONTRACTWATCH_MIN_ITEMS=2
CONTRACTWATCH_DAYS=3
CONTRACTWATCH_MAX_ITEMS=5
# Pulse digest window in hours; PULSE_EVERY_CYCLES>0 posts it from watch
# (watch runs every 10 min, so 6 = hourly - handy on deadline day; 0 = manual only)
PULSE_HOURS=24
PULSE_EVERY_CYCLES=0

# Where seen.json / drafts / downloaded media live.
# Local dev: leave unset (defaults to repo root).
# Render: set to /var/data (see render.yaml disk mount).
TRANSFER_DESK_STORAGE=
